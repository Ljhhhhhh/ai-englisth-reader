generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum ArticleVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id                String                  @id @default(cuid())
  email             String                  @unique
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  ownedArticles     Article[]
  verificationCodes EmailVerificationCode[]
  sessions          Session[]
  generationJobs    GenerationJob[]
  readingProgresses ReadingProgress[]
  savedWords        SavedWord[]
  learningEvents    LearningEvent[]
}

model EmailVerificationCode {
  id         String   @id @default(cuid())
  userId     String
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, expiresAt])
  @@index([userId, createdAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Article {
  id                       String            @id @default(cuid())
  slug                     String            @unique
  title                    String
  chineseTitle             String
  source                   String
  difficulty               String
  estimatedMinutes         Int
  listSummaryZh            String
  feynmanSummary           String
  chineseTranslation       String
  paragraphsJson           Json
  growthVocabularyJson     Json
  highFrequencyPhrasesJson Json
  languageEvolutionJson    Json
  visibility               ArticleVisibility @default(PUBLIC)
  ownerId                  String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  owner                    User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  progresses               ReadingProgress[]
  quizAttempts             QuizAttempt[]
  savedWords               SavedWord[]
  learningEvents           LearningEvent[]

  @@index([ownerId, visibility])
  @@index([visibility, estimatedMinutes, createdAt])
  @@index([ownerId, createdAt])
}

model GenerationJob {
  id          String   @id @default(cuid())
  userId      String
  status      String   @default("pending")
  sourceType  String
  sourceRef   String
  articleSlug String?
  errorMsg    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

model ReadingProgress {
  id            String   @id @default(cuid())
  userId        String
  articleId     String
  currentStage  String   @default("intro")
  paragraphId   String?
  quizStarted   Boolean  @default(false)
  quizSubmitted Boolean  @default(false)
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, updatedAt])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  deviceId    String
  articleId   String
  answersJson String
  score       Int
  createdAt   DateTime @default(now())
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([deviceId, articleId])
}

model SavedWord {
  id             String   @id @default(cuid())
  userId         String
  articleId      String
  lemma          String
  surface        String
  meaning        String
  contextMeaning String?
  memoryHook     String?
  usageExample   String?
  sentenceId     String?
  sourceSentence String
  createdAt      DateTime @default(now())
  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId, lemma])
  @@index([userId, createdAt])
}

model LearningEvent {
  id          String   @id @default(cuid())
  userId      String
  articleId   String?
  type        String
  payloadJson String?
  createdAt   DateTime @default(now())
  article     Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}
