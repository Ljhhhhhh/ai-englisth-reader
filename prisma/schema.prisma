generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                String                  @id @default(cuid())
  email             String                  @unique
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  verificationCodes EmailVerificationCode[]
  sessions          Session[]
}

model EmailVerificationCode {
  id         String   @id @default(cuid())
  userId     String
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, expiresAt])
  @@index([userId, createdAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Article {
  id                 String           @id @default(cuid())
  slug               String           @unique
  title              String
  source             String
  difficulty         String
  estimatedMinutes   Int
  feynmanSummary     String
  chineseTranslation String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  progresses         ReadingProgress[]
  quizAttempts       QuizAttempt[]
  savedWords         SavedWord[]
  learningEvents     LearningEvent[]
}

model GenerationJob {
  id         String   @id @default(cuid())
  deviceId   String
  status     String   @default("pending")
  sourceType String
  sourceRef  String
  articleSlug String?
  errorMsg   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([deviceId, createdAt])
  @@index([status])
}

model ReadingProgress {
  id            String   @id @default(cuid())
  deviceId      String
  articleId     String
  currentStage  String   @default("intro")
  paragraphId   String?
  quizStarted   Boolean  @default(false)
  quizSubmitted Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([deviceId, articleId])
  @@index([deviceId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  deviceId    String
  articleId   String
  answersJson String
  score       Int
  createdAt   DateTime @default(now())
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([deviceId, articleId])
}

model SavedWord {
  id             String   @id @default(cuid())
  deviceId       String
  articleId      String
  lemma          String
  surface        String
  meaning        String
  sourceSentence String
  createdAt      DateTime @default(now())
  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([deviceId, articleId, lemma])
  @@index([deviceId])
}

model LearningEvent {
  id          String   @id @default(cuid())
  deviceId    String
  articleId   String?
  type        String
  payloadJson String?
  createdAt   DateTime @default(now())
  article     Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([deviceId, type])
}
